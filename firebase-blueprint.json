{
  "entities": {
    "Interaction": {
      "title": "Interaction",
      "description": "User journal entry or reflection conversation with Gemini",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the interaction"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "title": {
          "type": "string",
          "description": "Title or topic of the entry"
        },
        "type": {
          "type": "string",
          "description": "Interaction mode (journal, reflection, brainstorm, summary)"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "messages": {
          "type": "array",
          "description": "Chronological multi-turn dialogue between user and Gemini"
        },
        "summary": {
          "type": "string",
          "description": "Key takeaways or reflection summary generated by Gemini"
        },
        "tags": {
          "type": "array",
          "description": "Categorization tags"
        },
        "mood": {
          "type": "string",
          "description": "User sentiment or emotional context"
        }
      },
      "required": ["userId", "title", "createdAt", "messages"]
    }
  },
  "firestore": {
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Isolated per-user interaction records ensuring strictly private access"
    }
  }
}
